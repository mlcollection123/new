# You can fill these in from the Settings tab of the dashboard instead of editing this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave empty to use sample leads
APOLLO_API_KEY=
# Shown in the email footer (anti-spam law requires a postal address)
SENDER_NAME=
SENDER_COMPANY=
SENDER_ADDRESS=
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
# Start low while the domain warms up
DAILY_CAP=5
SEND_DELAY_MS=120000
FOLLOWUP_DAYS=3,7
# reply (default): footer asks people to reply "unsubscribe". link: needs `serve` on a public HTTPS URL, plus PUBLIC_URL and UNSUB_SECRET.
UNSUB_MODE=reply
# Optional. Where data is stored. Default data/agent.db
# DB_PATH=data/agent.db
# Optional. Set a password (12+ characters) only if you expose the dashboard beyond this computer.
# DASHBOARD_PASSWORD=
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=4000
