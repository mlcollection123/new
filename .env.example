DATABASE_URL=postgres://agent:agent@localhost:5432/agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave empty to use sample leads (dry run)
APOLLO_API_KEY=
# Postal address and sender identity for the email footer (CAN-SPAM)
SENDER_NAME=
SENDER_COMPANY=
SENDER_ADDRESS=
# Use a separate sending domain, never your main one
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# reply (default): people reply "unsubscribe", no public server needed. link: needs `serve` on a public HTTPS URL.
UNSUB_MODE=reply
# Public URL of this server, used in the unsubscribe link
PUBLIC_URL=http://localhost:3000
# Random string, 32+ chars, signs unsubscribe links
UNSUB_SECRET=
# Start low and raise slowly while the domain warms up
DAILY_CAP=20
SEND_DELAY_MS=60000
PORT=3000
# Dashboard login (any username). 12+ characters. Binds to localhost, reach it over an SSH tunnel or HTTPS proxy.
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000
# Mailbox that receives replies. User and password default to the SMTP ones.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Days after the previous email for each follow-up
FOLLOWUP_DAYS=3,7
